{
  "name": "octo-health-mcp",
  "version": "1.0.0",
  "description": "AI-powered health agent for Swiggy users — scores order history and gives personalized nutrition recommendations using Swiggy Food, Instamart & Dineout MCP servers.",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "agent": "ts-node src/agent/cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["swiggy", "health", "mcp", "ai-agent", "claude", "nutrition"],
  "author": "Sushant Kataria",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.10.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.14.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  }
}
