# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Swiggy OAuth (from Builders Club dashboard)
SWIGGY_CLIENT_ID=your_swiggy_client_id
SWIGGY_CLIENT_SECRET=your_swiggy_client_secret

# MCP Server endpoints (provided by Swiggy)
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/instamart
SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout

# App
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change_me_in_production_use_random_32char_string

# Redirect URI registered with Swiggy
REDIRECT_URI=http://localhost:3000/auth/swiggy/callback
